generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
enum Role {
  USER
  MODERATOR
  ADMIN
}
// THE PLATEFROM OWNER (YOU)
model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  isSuperAdmin Boolean        @default(false)  
  projects     Project[] 
  sessions     AdminSession[]
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ADMIN SESSIONS
model AdminSession {
  id           String   @id @default(uuid())
  adminId      String
  refreshToken String   @unique
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt DateTime
}

// 2. THE TENANT (The App being built)
model Project {
  id          String   @id @default(uuid())
  name        String
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  apiKeys     ApiKey[]
  users       User[]   
  notifications Notification[] 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. THE SDK ACCESS KEY
model ApiKey {
  id          String    @id @default(uuid())
  keyHash     String    @unique
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  expiresAt   DateTime? 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 4. THE END-USER (The person using the App)
model User {
  id           String    @id @default(uuid())
  email        String
  phone        String?
  passwordHash String?   
  googleId     String?   
  
  role         Role      @default(USER) 
  
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  sessions     Session[] 
  notifications Notification[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Tenant & OAuth Isolation
  @@unique([email, projectId]) 
  @@unique([googleId, projectId]) 
  @@unique([phone, projectId]) 
}

// 5. THE END-USER SESSIONS
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt     DateTime
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}
enum NotificationStatus {
  PENDING
  DELIVERED
  READ
  FAILED
}
enum NotificationPriority {
  HIGH
  BULK
}

model Notification {
  id          String              @id @default(uuid())

  eventId     String              // ← NEW: idempotency key from Kafka

  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel     NotificationChannel
  priority    NotificationPriority @default(BULK)  // ← NEW
  status      NotificationStatus  @default(PENDING)

  title       String?
  body        String
  metadata    Json?
  retryCount  Int                 @default(0)
  errorReason String?

  deliveredAt DateTime?
  readAt      DateTime?           // ← NEW: for read-time analytics
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Idempotency: one notification per event per project
  @@unique([projectId, eventId])

  // Fast "fetch unread inbox" for 50k users turning on screen
  @@index([userId, status, channel, createdAt(sort: Desc)])

  // Admin dashboard: "show failures this week for project X"
  @@index([projectId, status, createdAt])

  // Optional: "show all HIGH priority pending for project X"
  @@index([projectId, priority, status])
}